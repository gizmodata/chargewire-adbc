# ADBC driver manifest template for the Warp SQL driver.
#
# Fill in the shared-library path(s) for your platform(s) and install as
# `warpsql.toml` into an ADBC driver search path, e.g.:
#   Linux:   ~/.config/adbc/drivers/warpsql.toml
#   macOS:   ~/Library/Application Support/ADBC/Drivers/warpsql.toml
#   Windows: %LOCALAPPDATA%\ADBC\Drivers\warpsql.toml
# (or any directory listed in the ADBC_DRIVER_PATH environment variable).
#
# Once installed, every ADBC driver manager can load the driver by name:
#   Python:   adbc_driver_manager.dbapi.connect(driver="warpsql", ...)
#   profiles: driver = "warpsql"

manifest_version = 1

name = 'Warp SQL'
version = '@VERSION@'
publisher = 'GizmoData'
license = 'Apache-2.0'
url = 'https://github.com/gizmodata/warp-sql-adbc'

[ADBC]
version = '1.1.0'

[Driver]
entrypoint = 'AdbcDriverWarpsqlInit'

[Driver.shared]
linux_amd64 = '@PREFIX@/libadbc_driver_warpsql.so'
linux_arm64 = '@PREFIX@/libadbc_driver_warpsql.so'
macos_amd64 = '@PREFIX@/libadbc_driver_warpsql.dylib'
macos_arm64 = '@PREFIX@/libadbc_driver_warpsql.dylib'
windows_amd64 = '@PREFIX@\\libadbc_driver_warpsql.dll'
windows_arm64 = '@PREFIX@\\libadbc_driver_warpsql.dll'

# ADBC driver manifest template for the Chargewire driver.
#
# Fill in the shared-library path(s) for your platform(s) and install as
# `chargewire.toml` into an ADBC driver search path, e.g.:
#   Linux:   ~/.config/adbc/drivers/chargewire.toml
#   macOS:   ~/Library/Application Support/ADBC/Drivers/chargewire.toml
#   Windows: %LOCALAPPDATA%\ADBC\Drivers\chargewire.toml
# (or any directory listed in the ADBC_DRIVER_PATH environment variable).
#
# Once installed, every ADBC driver manager can load the driver by name:
#   Python:   adbc_driver_manager.dbapi.connect(driver="chargewire", ...)
#   profiles: driver = "chargewire"

manifest_version = 1

name = 'Chargewire'
version = '@VERSION@'
publisher = 'GizmoData'
license = 'Apache-2.0'
url = 'https://github.com/gizmodata/chargewire-adbc'

[ADBC]
version = '1.1.0'

[Driver]
entrypoint = 'AdbcDriverChargewireInit'

[Driver.shared]
linux_amd64 = '@PREFIX@/libadbc_driver_chargewire.so'
linux_arm64 = '@PREFIX@/libadbc_driver_chargewire.so'
macos_amd64 = '@PREFIX@/libadbc_driver_chargewire.dylib'
macos_arm64 = '@PREFIX@/libadbc_driver_chargewire.dylib'
windows_amd64 = '@PREFIX@\\libadbc_driver_chargewire.dll'
windows_arm64 = '@PREFIX@\\libadbc_driver_chargewire.dll'

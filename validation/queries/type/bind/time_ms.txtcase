// part: metadata

[tags]
sql-type-name = "TIME"
caveats = ["DuckDB stores TIME at microsecond precision: values come back as time64[us], finer digits dropped."]

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "ttu",
            "flags": [
                "nullable"
            ]
        }
    ]
}

// part: expected

{"res": 0}
{"res": null}
{"res": 49531123000}
{"res": 45045500000}
{"res": 86399999000}

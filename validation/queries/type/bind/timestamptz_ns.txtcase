// part: metadata

[tags]
sql-type-name = "TIMESTAMPTZ"
caveats = ["DuckDB stores TIMESTAMPTZ at microsecond precision, and reads the extreme int64 nanosecond values as its infinity special values; this case binds nearby finite values. See https://duckdb.org/docs/current/sql/data_types/timestamp#special-values."]
partial-support = true

// part: bind

{"idx": 3, "res": 1684158330000000000, "res2": 1684158330000000000}
{"idx": 2, "res": 946684800000000000, "res2": 946684800000000000}
{"idx": 1, "res": -9223372036854775000, "res2": -9223372036854775000}
{"idx": 4, "res": 9223372036854775000, "res2": 9223372036854775000}
{"idx": 0, "res": null, "res2": null}

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "tsu:UTC",
            "flags": [
                "nullable"
            ]
        },
        {
            "name": "res2",
            "format": "tsu:UTC",
            "flags": [
                "nullable"
            ]
        }
    ]
}

// part: expected

{"res": null, "res2": null}
{"res": -9223372036854775, "res2": -9223372036854775}

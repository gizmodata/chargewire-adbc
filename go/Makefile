# Builds libadbc_driver_chargewire, the driver as a C shared library (cgo) that
# any ADBC driver manager loads, and runs the tests.

GOOS := $(shell go env GOOS)

ifeq ($(GOOS),linux)
	SUFFIX = so
else ifeq ($(GOOS),windows)
	SUFFIX = dll
else
	SUFFIX = dylib
endif

LIB = build/libadbc_driver_chargewire.$(SUFFIX)
VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
LDFLAGS = -s -w -X github.com/adbc-drivers/driverbase-go/driverbase.infoDriverVersion=$(VERSION)

# The cgo exports in pkg/chargewire are generated by driverbase-go's ffitemplate,
# from the same commit as the driverbase dependency.
DRIVERBASE_VERSION = $(shell go list -m -f '{{.Version}}' github.com/adbc-drivers/driverbase-go/driverbase)
FFITEMPLATE = github.com/adbc-drivers/driverbase-go/ffitemplate@$(DRIVERBASE_VERSION)

.PHONY: all lib test integration-test regenerate clean

all: lib

lib: $(LIB)

$(LIB): $(shell find chargewire internal pkg -name '*.go' -o -name '*.[ch]') go.mod go.sum
	CGO_ENABLED=1 go build -tags driverlib -buildmode=c-shared -ldflags "$(LDFLAGS)" -o $(LIB) ./pkg/chargewire

# Unit tests: no server needed.
test:
	go test -race ./...

# The live-server suite. CHARGEWIRE_ADBC_TEST_SERVER_BINARY must name a
# chargewire-duckdb binary; without it the suite fails.
integration-test:
	go test -race -tags integration -count=1 ./...

# Regenerate the cgo exports (needs goimports and clang-format on PATH).
regenerate:
	mkdir -p chargewire/pkg
	cd "$$(go mod download -json $(FFITEMPLATE) | sed -n 's/.*"Dir": "\(.*\)",/\1/p')" && \
		GOFLAGS=-mod=mod go run . -prefix Chargewire -driver $(CURDIR)/chargewire -in ./_tmpl
	for f in driver.go utils.c utils.h; do install -m 644 chargewire/pkg/$$f pkg/chargewire/$$f; done
	rm -rf chargewire/pkg

clean:
	rm -rf build
